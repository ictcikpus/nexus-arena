{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-arena",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ARENA_ROOMS", "class_name": "ArenaRoom" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaRoom", "RoomDirectory"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
